# =============================================================================
# MaalRise — environment configuration
# Copy to .env.local for development. Never commit real keys.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Project URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. Server-side only: cron jobs, PDF/Excel generation and
# admin user management. It bypasses RLS, so it must never reach the browser
# and must never be prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=MaalRise
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Local development database (supabase start) -----------------------------
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
